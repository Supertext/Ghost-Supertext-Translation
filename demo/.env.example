# Demo variables. Set them in Railway (service variables), never commit real values.

# Administrator (Ghost role Owner). Replaces Ghost's first-run "create your account" screen.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
# Editor account (Ghost role Editor), used for tests and screenshots.
DEMO_EDITOR_EMAIL=editor@example.com
DEMO_EDITOR_PASSWORD=
# Ghost needs passwords of at least 10 characters that are not too simple.

# Supertext API key (without it, translations fail with a clear message).
SUPERTEXT_API_KEY=

# Optional
# DEMO_SITE_TITLE=Supertext Translation Demo
# DEMO_ADMIN_NAME=Supertext Admin
# DEMO_EDITOR_NAME=Demo Editor
# TARGET_LANGUAGES=de-CH,fr-CH
# SOURCE_LANGUAGE=en
# SUPERTEXT_POLITENESS=more
# url=https://blog.example.com   # only when not on Railway (Railway's public domain is used otherwise)
